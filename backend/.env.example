DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
COOKIE_SECURE="false"
# Si se define, hace falta este código exacto para poder crear una cuenta
# de organizador nueva (POST /api/auth/register). Dejalo vacío/sin definir
# para que el registro quede abierto (útil en desarrollo local).
REGISTRATION_SECRET=""

# --- Notificaciones al comprador (todas opcionales) ---
# Envía el código de compra por email cuando el contacto que dejó el
# comprador parece un email. Necesita una cuenta de Gmail con verificación
# en dos pasos y una "contraseña de aplicación" (no la contraseña normal):
# https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Bot de Telegram para avisar por chat. Se crea hablándole a @BotFather en
# Telegram (/newbot) — te da el token y podés elegir el username del bot.
# Después de configurar esto, hay que registrar el webhook una sola vez:
# curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<URL_PUBLICA_DEL_BACKEND>/api/telegram/webhook"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Clave del panel /platform-admin (bloquear/borrar organizadores). Sin
# esto configurado, el panel devuelve error y queda inaccesible.
PLATFORM_ADMIN_SECRET=""
