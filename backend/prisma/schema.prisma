generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Un "Organizer" es una cuenta independiente: cada uno tiene su propio
// slug (ej. /mi-club), su propia clave de acceso y sus propios torneos.
// Esto es lo que permite que la app se replique para otros organizadores
// sin que nadie pueda tocar los datos de los demás.
model Organizer {
  id                String   @id @default(cuid())
  slug              String   @unique
  siteName          String
  passwordHash      String
  buyerPasscodeHash String?
  sheetUrl          String?
  etherscanKey      String?
  createdAt         DateTime @default(now())

  tournaments Tournament[]
  packages    Package[]
}

model Tournament {
  id          String @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  name        String
  // Todos los montos se guardan en "micro-USDT" (USDT * 1e6), como enteros,
  // para poder comparar montos on-chain sin errores de punto flotante.
  buyInMicro           Float
  totalPercent         Float
  markup               Float
  maxBullets           Int    @default(1)
  roiEstimado          Float?
  pricePerPercentMicro Float
  walletAddress        String
  walletAddressEvm     String?
  deadline             String?
  status               String @default("activo")
  liveStatus           String @default("registro")
  liveNote             String @default("")
  liveUpdatedAt        DateTime @default(now())
  createdAt            DateTime @default(now())
  // Contador sin significado propio: se incrementa al iniciar cada compra
  // para tomar un lock de fila de inmediato y así serializar la
  // validación de % disponible entre compras simultáneas (ver
  // publicRoutes.js).
  version              Int      @default(0)

  purchases Purchase[]

  @@index([organizerId])
}

// Un paquete agrupa varios torneos (cada uno con su propio buy-in, ROI y
// markup) y se vende como un solo producto: un comprador paga un único
// monto por X% del paquete completo, aplicado a todos los torneos
// incluidos a la vez.
model Package {
  id          String @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  name             String
  totalPercent     Float
  // Condiciones/notas visibles para el comprador (ej. "todo lo que no se
  // juega se devuelve") — a diferencia de liveNote, esto se carga al
  // armar el paquete y no cambia con el estado en vivo.
  notes            String?
  walletAddress    String
  walletAddressEvm String?
  deadline         String?
  status           String @default("activo")
  liveStatus       String @default("registro")
  liveNote         String @default("")
  // Nombre (no id, para no romperse si se edita el paquete y se
  // reemplazan los torneos incluidos) del torneo del paquete que se está
  // jugando en este momento — se muestra junto al estado en vivo.
  currentLegName   String?
  liveUpdatedAt    DateTime @default(now())
  createdAt        DateTime @default(now())
  version          Int      @default(0)

  legs      PackageLeg[]
  purchases Purchase[]

  @@index([organizerId])
}

// Un torneo dentro de un paquete. No se vende por separado: existe solo
// para describir de qué se compone el paquete y calcular su precio.
model PackageLeg {
  id        String @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  name        String
  buyInMicro  Float
  markup      Float
  roiEstimado Float?
  maxBullets  Int    @default(1)
  sortOrder   Int    @default(0)

  @@index([packageId])
}

model Purchase {
  id           String @id @default(cuid())
  // Una compra pertenece a un torneo O a un paquete, nunca a los dos ni a
  // ninguno — eso se valida en el código de la ruta, no acá.
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  packageId    String?
  package      Package?    @relation(fields: [packageId], references: [id], onDelete: Cascade)

  code              String @unique
  buyerName         String
  buyerContact      String
  originWallet      String?
  percent           Float
  baseAmountMicro   Float
  uniqueAmountMicro Float
  network           String
  walletAddress     String
  status            String  @default("pendiente")
  txHash            String?
  unreadOrganizer   Int     @default(0)
  lastVerifyAt      DateTime?
  createdAt         DateTime @default(now())

  messages Message[]

  // Garantiza a nivel de base de datos que dos compras nunca compartan
  // el mismo monto único dentro del mismo torneo (o paquete) y red (evita
  // ambigüedad al detectar el pago en la blockchain). Postgres no aplica
  // unicidad entre valores NULL, así que estas dos conviven sin pisarse:
  // una compra de torneo tiene packageId=NULL y viceversa.
  @@unique([tournamentId, network, uniqueAmountMicro])
  @@unique([packageId, network, uniqueAmountMicro])
  @@index([tournamentId])
  @@index([packageId])
}

model Message {
  id         String @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  sender    String
  text      String
  createdAt DateTime @default(now())

  @@index([purchaseId])
}
